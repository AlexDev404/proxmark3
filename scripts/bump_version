# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# See LICENSE.txt for the text of the license.
#-----------------------------------------------------------------------------
# libnxpsc - bump the library version in the two places that declare it
#-----------------------------------------------------------------------------

set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
HEADER="$ROOT/include/nxpsc/nxpsc.h"
CMAKE="$ROOT/CMakeLists.txt"

usage() {
    cat <<'USAGE'
usage: scripts/bump_version [--major|-m] [--minor|-mm] [--patch|-p]

Bumps the version in include/nxpsc/nxpsc.h and CMakeLists.txt. Defaults to
--patch. A major bump zeroes the minor and the patch, a minor bump zeroes the
patch. libnxpsc.pc takes its version from CMake, so it follows on its own.
USAGE
}

part=patch
seen=0

while [ $# -gt 0 ]; do
    case "$1" in
        --major|-m)
            part=major; seen=$((seen + 1));;
        --minor|-mm)
            part=minor; seen=$((seen + 1));;
        --patch|-p)
            part=patch; seen=$((seen + 1));;
        --help|-h)
            usage; exit 0;;
        *)
            echo "bump_version: unknown argument '$1'" >&2
            usage >&2
            exit 2;;
    esac
    shift
done

if [ "$seen" -gt 1 ]; then
    echo "bump_version: pick one of --major, --minor or --patch" >&2
    exit 2
fi

# the header is the source of truth, CMake has to agree with it
read_macro() {
    sed -n "s/^#define NXPSC_VERSION_$1[[:space:]]\{1,\}\([0-9]\{1,\}\).*/\1/p" "$HEADER"
}

major=$(read_macro MAJOR)
minor=$(read_macro MINOR)
patch=$(read_macro PATCH)

if [ -z "$major" ] || [ -z "$minor" ] || [ -z "$patch" ]; then
    echo "bump_version: could not read the version macros from $HEADER" >&2
    exit 1
fi

current="$major.$minor.$patch"

cmake_current=$(sed -n "s/^project(nxpsc VERSION \([0-9.]\{1,\}\).*/\1/p" "$CMAKE")
if [ -z "$cmake_current" ]; then
    echo "bump_version: could not read the project version from $CMAKE" >&2
    exit 1
fi

if [ "$cmake_current" != "$current" ]; then
    echo "bump_version: $CMAKE says $cmake_current but $HEADER says $current," >&2
    echo "              fix that by hand before bumping" >&2
    exit 1
fi

case "$part" in
    major) major=$((major + 1)); minor=0; patch=0;;
    minor) minor=$((minor + 1)); patch=0;;
    patch) patch=$((patch + 1));;
esac

new="$major.$minor.$patch"

# both files are CRLF and a sed that translates line endings would rewrite
# every line of them, so ask for binary mode where the sed has one. the
# patterns replace the digits alone and leave the rest of the line, carriage
# return included, where it is
binary=""
if sed --help 2>&1 | grep -q -- "--binary"; then
    binary="-b"
fi

edit() {
    file=$1
    shift
    tmp="$file.bump.$$"
    sed ${binary:+"$binary"} "$@" "$file" > "$tmp"
    mv "$tmp" "$file"
}

edit "$HEADER" \
    -e "s/^\(#define NXPSC_VERSION_MAJOR[[:space:]]\{1,\}\)[0-9]\{1,\}/\1$major/" \
    -e "s/^\(#define NXPSC_VERSION_MINOR[[:space:]]\{1,\}\)[0-9]\{1,\}/\1$minor/" \
    -e "s/^\(#define NXPSC_VERSION_PATCH[[:space:]]\{1,\}\)[0-9]\{1,\}/\1$patch/"

edit "$CMAKE" -e "s/^\(project(nxpsc VERSION \)[0-9.]\{1,\}/\1$new/"

echo "$current -> $new ($part)"
echo "  $HEADER"
echo "  $CMAKE"
