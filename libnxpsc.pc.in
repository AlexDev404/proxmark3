prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libnxpsc
Description: Portable low level library for NXP DESFire, MIFARE Plus, NTAG 424 and DUOX smartcards
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lnxpsc
Cflags: -I${includedir}
